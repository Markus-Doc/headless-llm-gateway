# Copy to .env (never committed) and fill in. One .env per machine.

# The gateway's own password. Clients send it as "Authorization: Bearer <key>".
# Make one with: python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=

# Anthropic Console API key, used only by the anthropic-haiku route.
# The claude-cli routes strip it from the child process so they bill the subscription.
ANTHROPIC_API_KEY=

# Optional. A Codex home used only by the gateway, so codex-cli calls do not carry
# your global AGENTS.md and skills. Log in there once: see README.
# GATEWAY_CODEX_HOME=C:\Users\<you>\.codex-gateway
